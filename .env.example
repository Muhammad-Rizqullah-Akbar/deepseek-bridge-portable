# ==============================================================================
# DEEPSEEK BRIDGE PORTABLE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Binding
DSB_HOST=127.0.0.1
DSB_PORT=8787

# Accounts & Pool Rotation (Nama akun dipisahkan titik koma, e.g. acc1;acc2)
# Jika kosong, bridge akan membaca data/session/accounts.json
DSB_ACCOUNTS=
DSB_MIN_GAP=0.2

# Persistence & Threads
DSB_THREAD_TTL=604800
DSB_KEEP_ALIVE=true

# Thinking & Stream Configuration
DSB_THINKING_INLINE=true

# 9router Gateway Integration
DSB_9ROUTER_URL=http://localhost:20128
DSB_API_KEY=xenonite
